# Use InfluxDB 1.7.11 as base for compatibility
FROM influxdb:1.7.11 as base

# Builder stage with Go 1.13.8 (compatible with InfluxDB 1.7.11)
FROM golang:1.13.8-alpine AS builder

# Install build dependencies
RUN apk add --no-cache git make bash gcc musl-dev

WORKDIR /src

# Copy module files first to leverage Docker cache for dependencies
COPY influxdb/go.mod influxdb/go.sum ./
COPY influxql/go.mod influxql/go.sum /influxql/

# Download dependencies (this step will be cached unless go.mod/go.sum changes)
RUN go mod download

# Copy source code
COPY influxdb/ .

# Copy the modified influxql package
COPY influxql/ /influxql

# Build modified InfluxDB
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /influxd ./cmd/influxd

# Final runtime image based on InfluxDB 1.7.11
FROM influxdb:1.7.11

# Replace the stock influxd with our modified version
COPY --from=builder /influxd /usr/bin/influxd

# Ensure proper permissions
RUN chmod +x /usr/bin/influxd

# Use the same entrypoint and config as stock InfluxDB 1.7.11
# This ensures compatibility with existing scripts and tools

EXPOSE 8086

# Keep the original InfluxDB entrypoint
ENTRYPOINT ["/entrypoint.sh"]
CMD ["influxd"]
